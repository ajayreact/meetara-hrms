.DS_Store
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/bootstrap/ssr
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/framework/browser-credentials.json
/storage/framework/browser-schema.sql
/storage/pail
/playwright-report
/test-results
/blob-report
/vendor
auth.json
Homestead.json
