# Environment files. .env.example remains available.
.env.*
!.env.example

# Runtime logs and private uploads
/storage/logs/*
!/storage/logs/.gitignore
/storage/app/private/*
!/storage/app/private/.gitignore
!/storage/app/private/.htaccess

# Local database dumps and backups
/database/schema/*.sql
/database/schema/*.dump
*.bak
*.dump

# Unverified recovery code stays on disk and out of the repository.
# Markdown audit reports under quarantine/ remain eligible to commit.
/quarantine/**/*.php
