APP_NAME="Meetara HRMS"
# Local WAMP values are below. They are not a production configuration.
# A public host must set its own values. See docs/production.md.
# Required on that host: APP_ENV=production, APP_DEBUG=false, and APP_URL
# set to the real HTTPS origin. Generate APP_KEY on the host. Do not copy
# the local key, and do not put a real key in this file.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

# Comma-separated reverse-proxy addresses allowed to set X-Forwarded-For.
# Leave empty for local WAMP, where the browser connects directly and the
# observed address is the socket address (often 127.0.0.1). That address is
# not an approved public office network, so clock-in stays blocked until the
# request reaches the server through an approved public IP.
# Never set this to *. A forwarded header from an untrusted peer is rejected.
# Set specific proxy addresses only when a reverse proxy is actually in front
# of the app. Leave this empty on local WAMP.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Local detail is useful in development. Production must use warning or error.
# Production should also set LOG_STACK=daily so Laravel rotates the files.
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=meetara_hrms
# Local WAMP uses the administrator account. Production must use a dedicated
# application account with only the privileges in docs/production.md.
# Keep that password out of this file, out of logs, and out of the local .env.
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Leave SESSION_ENCRYPT and SESSION_SECURE_COOKIE unset so production inherits
# encryption and the Secure cookie. An explicit false, including a copied
# local SESSION_ENCRYPT=false, overrides that production default.
# SESSION_ENCRYPT=
# SESSION_SECURE_COOKIE=
SESSION_HTTP_ONLY=true
# Lax keeps the session on a top-level visit from a mail link. Use strict only
# after confirming those links still sign the user in. Do not use none.
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Zoho ZeptoMail SMTP. Invitations and password resets are sent synchronously.
# A queue worker is not required. Leave the password empty in this example.
# Put the mailbox password only in the server .env, never in git.
# Employee invitation links expire after 72 hours. APP_URL must be the public
# origin so invitation and password-reset links open the right site.
# Port 465 uses SSL. Alternative TLS:
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS must be a verified sender on MAIL_SENDER_DOMAIN.
# log, array, an empty password, and hello@example.com do not count as delivery.
# Do not put invitation tokens, reset tokens, passwords, or mailbox credentials in logs.
MAIL_MAILER=smtp
MAIL_HOST=smtp.zeptomail.in
MAIL_PORT=465
MAIL_USERNAME=emailapikey
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_TIMEOUT=15
MAIL_SENDER_DOMAIN=meetara.net
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Meetara HRMS"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Candidate onboarding protections. Leave the scanner and verification
# values empty until those services are installed. required is the safe
# default: the public form cannot be enabled until both are configured.
# Tests set CANDIDATE_MALWARE_SCAN=off and CANDIDATE_CAPTCHA=off.
# Do not put a real Turnstile secret in this example file.
CANDIDATE_PASSWORD_TIMEOUT=900
CANDIDATE_MALWARE_SCAN=required
CANDIDATE_CLAMAV_COMMAND=
CANDIDATE_CLAMAV_TIMEOUT=10
CANDIDATE_CAPTCHA=required
CANDIDATE_TURNSTILE_SITE_KEY=
CANDIDATE_TURNSTILE_SECRET=
# Empty means no retention period is approved and nothing is deleted.
CANDIDATE_RETENTION_DAYS=
